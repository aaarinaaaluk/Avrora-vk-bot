# === VK Callback API ===
# Вставьте значения из настроек сообщества VK.
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_SECRET=

# === GigaChat API (основной ключ ИИ) ===
# GigaChat Studio -> ваш проект -> Настройки API -> Получить ключ.
# Вставьте Authorization Key в GIGACHAT_AUTH_KEY; Access Token сюда не вставлять.
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_BASE_URL=https://api.giga.chat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Альтернатива: если используете Client ID + Client Secret вместо Authorization Key.
# Оставьте GIGACHAT_AUTH_KEY пустым и заполните обе следующие строки.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# === Google Fact Check Tools API (необязательно) ===
GOOGLE_FACT_CHECK_API_KEY=

# === PubMed / NCBI (необязательно; поиск работает и без них) ===
NCBI_API_KEY=
NCBI_EMAIL=
